{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "description": "HTTPS API that turns a LinkedIn profile URL into structured JSON, built on LinkedIn's internal Voyager API with a headless-browser fallback.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run --exclude tests/live",
    "test:watch": "vitest --exclude tests/live",
    "test:live": "vitest run tests/live",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "record-fixture": "tsx scripts/record-fixture.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.11.0"
}
