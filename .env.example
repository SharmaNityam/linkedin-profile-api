# LinkedIn session cookie. Log in to linkedin.com in a browser, open DevTools →
# Application → Cookies → https://www.linkedin.com → copy the value of `li_at`.
# Never commit the real value.
LI_AT=

# Optional: the same browser's other linkedin.com cookies. Without this the
# backend bootstraps its own companion cookies on first use. To reuse the browser's,
# run `copy(document.cookie)` in that browser's DevTools console and paste here.
# (li_at is HttpOnly so it is not part of this string, that's why it's separate.)
LI_COOKIES=

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Protects the LinkedIn account behind the API
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_UPSTREAM=2

# Optional: the `voyagerFeedDashProfileUpdates` persisted-query hash used by
# /v1/posts. LinkedIn rotates these; the built-in default is used when unset.
# When /v1/posts starts returning 502 SCHEMA_DRIFT, open
# linkedin.com/in/<slug>/recent-activity/all/ with DevTools on the Network tab,
# filter for `graphql?queryId=voyagerFeedDashProfileUpdates`, and copy the hash
# from the end of the request URL.
# VOYAGER_POSTS_QUERY_ID=

# Email-OTP gate on /v1/*. Required: 64 hex chars (32 bytes), e.g.
# `openssl rand -hex 32`. Encrypts and signs the session cookie; rotating it
# signs every caller out.
SESSION_KEY=

# Mailer for one-time codes. See README → Access → "Sending codes". Brevo (API,
# HTTPS) wins when BREVO_API_KEY is set; otherwise SMTP is used when SMTP_USER/
# SMTP_PASS are set; otherwise codes are only logged. One of the two is
# required when NODE_ENV=production; both unset is fine in development.

# Option A: Brevo — recommended on hosts that block outbound SMTP (e.g. Render
# free tier). EMAIL_FROM must be the Gmail address verified as a Brevo sender.
# BREVO_API_KEY=
# EMAIL_FROM defaults to SMTP_USER, otherwise required when BREVO_API_KEY is set
# EMAIL_FROM=

# Option B: Gmail account + app password, sent over SMTP.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# The only Origin a mutating request may declare (CSRF defence for the cookie).
APP_ORIGIN=http://localhost:3000

# OTP issuance limits: per IP on /auth/request-code, /auth/verify and
# /auth/login, and per email address on code issuance.
OTP_RATE_LIMIT_PER_HOUR=10
OTP_PER_EMAIL_PER_HOUR=5

# Domains /auth/request-code will mail a code to; a deterrent against
# throwaway addresses, not a real check. See README → Access.
# ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,myyahoo.com

# Distinct verified accounts a single IP may accumulate in a trailing 7 days
# before /auth/request-code starts refusing new ones. See README → Access.
# ACCOUNTS_PER_IP=10

# Optional shared tester credential for POST /auth/login, separate from the
# OTP flow and exempt from the allowlist and the per-IP cap above. Set both
# or neither; ADMIN_PASSWORD must be at least 12 characters.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

