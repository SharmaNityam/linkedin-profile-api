# LinkedIn session cookie. Log in to linkedin.com in a browser, open DevTools →
# Application → Cookies → https://www.linkedin.com → copy the value of `li_at`.
# Never commit the real value.
LI_AT=

# Optional: the same browser's other linkedin.com cookies. Without this the
# backend bootstraps its own companion cookies on first use. To reuse the browser's,
# run `copy(document.cookie)` in that browser's DevTools console and paste here.
# (li_at is HttpOnly so it is not part of this string, that's why it's separate.)
LI_COOKIES=

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Protects the LinkedIn account behind the API
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_UPSTREAM=2

# Optional: the `voyagerFeedDashProfileUpdates` persisted-query hash used by
# /v1/posts. LinkedIn rotates these; the built-in default is used when unset.
# When /v1/posts starts returning 502 SCHEMA_DRIFT, open
# linkedin.com/in/<slug>/recent-activity/all/ with DevTools on the Network tab,
# filter for `graphql?queryId=voyagerFeedDashProfileUpdates`, and copy the hash
# from the end of the request URL.
# VOYAGER_POSTS_QUERY_ID=


# --- Accounts ----------------------------------------------------------------

# development | test | production. Production additionally requires DATABASE_URL,
# RESEND_API_KEY and a non-localhost APP_ORIGIN, and puts `Secure` on the
# session cookie.
NODE_ENV=development

# Postgres connection string (Neon's pooled one in production). Required when
# NODE_ENV=production; unset locally means accounts live in memory and are lost
# on restart.
# DATABASE_URL=postgres://user:password@host/dbname

# Session cookie key. Required. Generate with `openssl rand -hex 32`
# (32 bytes as 64 hex characters). Changing it signs everyone out.
SESSION_KEY=

# The origin the playground is served from. The only Origin a POST/PUT/PATCH/
# DELETE may declare, and it must not be localhost when NODE_ENV=production.
APP_ORIGIN=http://localhost:3000

# Resend API key for the verification email. Unset means codes are written to
# the log instead of mailed, which is what you want locally and why it is
# required when NODE_ENV=production.
RESEND_API_KEY=

# The From address on that email. Resend's shared sender works without a
# verified domain.
EMAIL_FROM=LinkedIn Profile API <onboarding@resend.dev>

# Abstract Phone Validation v1 key. Unset means every number is `skipped`.
ABSTRACT_API_KEY=

# What to do when the phone provider gives no verdict (no key, no quota, its
# 5xx): `open` accepts the number and reports `phoneValidation: "skipped"`,
# `closed` rejects the signup.
PHONE_VALIDATION_FAIL_MODE=open

# Comma-separated override for the built-in consumer email domain allowlist
# (Google, Microsoft and Yahoo domains). Unset uses the built-in list.
# ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com

# Per-IP hourly budget for /auth/*, the endpoints an anonymous caller reaches.
AUTH_RATE_LIMIT_PER_HOUR=20

# Which algorithm new passwords are hashed with: `argon2` (argon2id, needs the
# native binding) or `scrypt` (pure node). Both verify each other's hashes, so
# switching re-hashes nothing and signs nobody out.
PASSWORD_HASHER=argon2
