# LinkedIn session cookie. Log in to linkedin.com in a browser, open DevTools →
# Application → Cookies → https://www.linkedin.com → copy the value of `li_at`.
# Never commit the real value.
LI_AT=

# Optional: the same browser's other linkedin.com cookies. Without this the
# backend bootstraps its own companion cookies on first use. To reuse the browser's,
# run `copy(document.cookie)` in that browser's DevTools console and paste here.
# (li_at is HttpOnly so it is not part of this string, that's why it's separate.)
LI_COOKIES=

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Protects the LinkedIn account behind the API
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_UPSTREAM=2

# Optional: the `voyagerFeedDashProfileUpdates` persisted-query hash used by
# /v1/posts. LinkedIn rotates these; the built-in default is used when unset.
# When /v1/posts starts returning 502 SCHEMA_DRIFT, open
# linkedin.com/in/<slug>/recent-activity/all/ with DevTools on the Network tab,
# filter for `graphql?queryId=voyagerFeedDashProfileUpdates`, and copy the hash
# from the end of the request URL.
# VOYAGER_POSTS_QUERY_ID=

# Email-OTP gate on /v1/*. Required: 64 hex chars (32 bytes), e.g.
# `openssl rand -hex 32`. Encrypts and signs the session cookie; rotating it
# signs every caller out.
SESSION_KEY=

# Gmail account + app password used to mail one-time codes. See README →
# Access → "Setting up Gmail as the mailer". Required when NODE_ENV=production;
# left unset in development, codes are logged instead of mailed.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM defaults to SMTP_USER
# EMAIL_FROM=

# The only Origin a mutating request may declare (CSRF defence for the cookie).
APP_ORIGIN=http://localhost:3000

# OTP issuance limits: per IP on /auth/request-code and /auth/verify, and per
# email address on code issuance.
OTP_RATE_LIMIT_PER_HOUR=10
OTP_PER_EMAIL_PER_HOUR=5

