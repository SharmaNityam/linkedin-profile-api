# LinkedIn session cookie. Log in to linkedin.com in a browser, open DevTools →
# Application → Cookies → https://www.linkedin.com → copy the value of `li_at`.
# Never commit the real value.
LI_AT=

# Optional: the same browser's other linkedin.com cookies. Without this the
# backend bootstraps its own companion cookies on first use. To reuse the browser's,
# run `copy(document.cookie)` in that browser's DevTools console and paste here.
# (li_at is HttpOnly so it is not part of this string — that's why it's separate.)
LI_COOKIES=

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Protects the LinkedIn account behind the API
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_UPSTREAM=2

# Headless-browser fallback (needs ~1GB RAM; keep false on small instances)
BROWSER_FALLBACK=false
